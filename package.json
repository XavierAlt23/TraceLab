{
  "name": "tracelab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "wrangler dev --local --ip 127.0.0.1 --port 8795",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts eslint.config.mjs --max-warnings=0",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/policy.test.mjs tests/integrity.test.mjs tests/security.test.mjs tests/worker-failure.test.mjs",
    "test:integration": "node scripts/test-phase5-local.mjs --phase6",
    "test:phase5:local": "node scripts/test-phase5-local.mjs",
    "test:volume": "node scripts/test-phase5-local.mjs --volume",
    "test:crypto:local": "node scripts/test-phase5-local.mjs --crypto",
    "dev:isolated": "node scripts/test-phase5-local.mjs --serve",
    "db:migrate:local": "wrangler d1 migrations apply tracelab-db --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.5",
    "wrangler": "^4.38.0"
  }
}
